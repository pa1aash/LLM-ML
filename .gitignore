# Credentials / secrets — never commit
credentials/
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Experiment outputs
# results/ is deliberately TRACKED from plan revision 4 (defect D-25):
# the results-file layer is what the G5 criterion depends on, and a
# gitignored layer cannot be checked by anyone who clones the repository.
data/
*.log

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz

# macOS metadata
.DS_Store

# Notebook checkpoints
.ipynb_checkpoints/

# Secrets (beyond credentials/ and *.pem above)
*.key
*.env

# hyperresearch: fetched third-party PDFs — never redistribute
research/raw/
# hyperresearch: local index databases (regenerated by `hyperresearch sync`)
research/.index.sqlite3
research/*.sqlite3
# hyperresearch: fetch cache
.hyperresearch/cache/

# Datasets and model weights (large, regenerated or downloaded).
# This covers the NAS-Bench-201 / NATS-Bench benchmark tables under
# datasets/nasbench201/ -- ~2.2 GB of archives plus the derived accuracy table.
# Their checksums, provenance and the API cross-check ARE tracked, at
# results/checksums/nasbench201.json (plan 3.1, DEVIATIONS.md D-013).
datasets/
*.ckpt
*.pt
*.pth
wandb/

# Internal planning notes — kept local, not part of the public surface
docs/

# Agent tooling scaffolding is excluded locally via .git/info/exclude
# (kept out of committed content by the authorship contract).
.hyperresearch/hyperresearch.db
.hyperresearch/hyperresearch.db-shm
.hyperresearch/hyperresearch.db-wal

# Transient subagent scratch dumps under research/temp (raw API/vault dumps).
# Deliverable artifacts there — claims-*.json and the *.md analyses — are tracked.
research/temp/or-*.json
research/temp/or-*.txt
research/temp/existing*.json
